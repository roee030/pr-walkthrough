        "@@ -0,0 +1,9 @@",
        "+import axios from 'axios';",
        "+import { tokenManager } from '@auth/tokenManager';",
        "+const API_KEY = \"sk_live_abcdef1234567890\";",
        "+export const client = axios.create({ baseURL: 'http://api.example.com' });",
        "+export async function processData(data: any) {",
        "+  const t = await tokenManager.getToken();",
        "+  const q = `SELECT * FROM users WHERE id = ${data.id}`;",
        "+  return client.post('/x', { data, q }, { headers: { Authorization: t } });",
        "+}"
